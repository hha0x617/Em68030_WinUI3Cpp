<ContentDialog
    x:Class="Em68030.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Emulator Settings"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    MinWidth="640"
    MinHeight="500"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <Style x:Key="DefaultContentDialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80" />
        </Style>
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD4D4D4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFD4D4D4" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF569CD6" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E42" />
            <Setter Property="Foreground" Value="#FFD4D4D4" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </ContentDialog.Resources>

    <TabView x:Name="SettingsTabs" IsAddTabButtonVisible="False"
             CanDragTabs="False" CanReorderTabs="False"
             TabWidthMode="SizeToContent">
        <!-- ==================== General Tab ==================== -->
        <TabViewItem x:Name="TabGeneral" Header="General" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="420" MaxHeight="420" Background="Transparent">
                <StackPanel Spacing="0" Background="Transparent">
                    <!-- Board Type -->
                    <TextBlock x:Name="LblBoardType" Text="Board Type" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblBoard" Text="Board:" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="BoardTypeBox" Grid.Column="1">
                            <ComboBoxItem Content="Generic" />
                            <ComboBoxItem Content="MVME147" />
                        </ComboBox>
                    </Grid>

                    <!-- Memory Settings -->
                    <TextBlock x:Name="LblMemory" Text="Memory" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblMemorySizeMB" Text="Memory Size (MB):" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="MemSizeBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}"
                                 ToolTipService.ToolTip="4-4096" />
                    </Grid>
                    <TextBlock x:Name="LblMemoryDescription" Text="Memory size changes take effect after reloading the kernel image."
                               Foreground="#FF808080" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <!-- I/O Device Settings (Generic) -->
                    <TextBlock x:Name="LblIoDevices" Text="I/O Devices" Style="{StaticResource SectionHeaderStyle}" />
                    <CheckBox x:Name="ConsoleEnabledBox" Content="Console Device Enabled"
                              Foreground="#FFD4D4D4" Margin="0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblConsoleBaseAddr" Text="Console Base Addr:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="ConsoleAddrBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblScrollbackLines" Text="Scrollback Lines:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="ConsoleScrollbackBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}"
                                 ToolTipService.ToolTip="0-100000" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblTerminalSize" Text="Terminal Size:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="ConsoleColumnsBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}"
                                 ToolTipService.ToolTip="80-320" />
                        <TextBlock Text=" x " Grid.Column="2" Style="{StaticResource SettingLabelStyle}" HorizontalAlignment="Center" />
                        <TextBox x:Name="ConsoleRowsBox" Grid.Column="3" Style="{StaticResource SettingTextBoxStyle}"
                                 ToolTipService.ToolTip="24-80" />
                    </Grid>

                    <CheckBox x:Name="HddEnabledBox" Content="HDD Device Enabled"
                              Foreground="#FFD4D4D4" Margin="0,8,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblHddBaseAddr" Text="HDD Base Addr:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="HddAddrBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                    </Grid>

                    <!-- HDD Image Settings -->
                    <TextBlock x:Name="LblHddImage" Text="HDD Image" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblImageFile" Text="Image File:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="HddPathBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                        <Button x:Name="BrowseHddBtn" Content="..." Grid.Column="2"
                                Style="{StaticResource BrowseButtonStyle}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock x:Name="LblHddNewImageSize" Text="New Image Size (MB):" Style="{StaticResource SettingLabelStyle}" Width="150" />
                        <TextBox x:Name="NewImageSizeBox" Width="80" Style="{StaticResource SettingTextBoxStyle}" Text="2048"
                                 ToolTipService.ToolTip="100-2097152" />
                        <Button x:Name="CreateHddImageBtn" Content="Create" Margin="8,0"
                                Background="#FF3E3E42" Foreground="#FFD4D4D4" Padding="8,2" />
                    </StackPanel>

                    <!-- Display Settings -->
                    <TextBlock x:Name="LblDisplay" Text="Display" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LblFontFamily" Text="Font Family:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="FontFamilyBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                        <TextBlock x:Name="LblFontSize" Text="Font Size:" Grid.Row="1" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="FontSizeBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <!-- ==================== MVME147 Tab ==================== -->
        <TabViewItem x:Name="TabMvme147" Header="MVME147" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="420" MaxHeight="420" Background="Transparent">
                <StackPanel x:Name="Mvme147Panel" Spacing="0" Background="Transparent">
                    <!-- MVME147 Settings -->
                    <TextBlock x:Name="LblMvme147Settings" Text="MVME147 Settings" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblRomImage" Text="ROM Image:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="Mvme147RomBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                        <Button x:Name="BrowseRomBtn" Content="..." Grid.Column="2"
                                Style="{StaticResource BrowseButtonStyle}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblKernelImage" Text="Kernel Image:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="KernelImagePathBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                        <Button x:Name="BrowseKernelBtn" Content="..." Grid.Column="2"
                                Style="{StaticResource BrowseButtonStyle}" />
                    </Grid>
                    <TextBlock x:Name="LblKernelImageDescription" Text="If specified, this kernel image is automatically loaded when the emulator starts."
                               Foreground="#FF808080" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <!-- Target OS -->
                    <TextBlock x:Name="LblTargetOS" Text="Target OS" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblOperatingSystem" Text="Operating System:" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="TargetOSBox" Grid.Column="1">
                            <ComboBoxItem Content="NetBSD" />
                            <ComboBoxItem Content="Linux" />
                        </ComboBox>
                    </Grid>
                    <!-- NetBSD-specific settings -->
                    <StackPanel x:Name="NetBsdPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblBootPartition" Text="Boot Partition:" Style="{StaticResource SettingLabelStyle}" />
                            <ComboBox x:Name="BootPartitionBox" Grid.Column="1"
                                      Width="60" HorizontalAlignment="Left">
                                <ComboBoxItem Content="a" />
                                <ComboBoxItem Content="b" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <!-- Linux-specific settings -->
                    <StackPanel x:Name="LinuxPanel" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblCommandLine" Text="Command Line:" Style="{StaticResource SettingLabelStyle}" />
                            <TextBox x:Name="LinuxCommandLineBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}"
                                     MaxWidth="400" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>

                    <!-- SCSI Disk Settings -->
                    <TextBlock x:Name="LblScsiDisks" Text="SCSI Disks" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="LblScsiDescription" Text="SCSI disk changes take effect after rebooting the guest OS. CD-ROM image can be swapped at any time."
                               Foreground="#FF808080" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <StackPanel x:Name="ScsiDiskListPanel" />
                    <Button x:Name="AddScsiDiskBtn" Content="+ Add Disk"
                            Margin="0,4" Padding="8,2" HorizontalAlignment="Left"
                            Background="#FF3E3E42" Foreground="#FFD4D4D4" />
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock x:Name="LblScsiNewImageSize" Text="New Image Size (MB):" Style="{StaticResource SettingLabelStyle}" Width="150" />
                        <TextBox x:Name="NewScsiImageSizeBox" Width="80" Style="{StaticResource SettingTextBoxStyle}" Text="2048"
                                 ToolTipService.ToolTip="100-2097152" />
                        <Button x:Name="CreateScsiImageBtn" Content="Create" Margin="8,0"
                                Background="#FF3E3E42" Foreground="#FFD4D4D4" Padding="8,2" />
                    </StackPanel>

                    <!-- SCSI CD-ROM Settings -->
                    <TextBlock x:Name="LblScsiCdRom" Text="SCSI CD-ROM" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LblIsoImage" Text="ISO Image:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="ScsiCdromPathBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                        <Button x:Name="BrowseScsiCdromBtn" Content="..." Grid.Column="2"
                                Style="{StaticResource BrowseButtonStyle}" />
                        <TextBlock x:Name="LblScsiCdromId" Text="SCSI ID:" Grid.Row="1" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="ScsiCdromIdBox" Grid.Row="1" Grid.Column="1"
                                  Width="60" HorizontalAlignment="Left">
                            <ComboBoxItem Content="0" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="6" />
                        </ComboBox>
                    </Grid>

                    <!-- Network Mode -->
                    <TextBlock x:Name="LblNetwork" Text="Network" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblNetworkMode" Text="Network Mode:" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="NetworkModeBox" Grid.Column="1">
                            <ComboBoxItem Content="Virtual (Echo Server)" />
                            <ComboBoxItem Content="NAT (Host Network)" />
                            <ComboBoxItem x:Name="TapModeItem" Content="TAP (Bridge)" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="LblNetworkDescription" Text="Network mode changes take effect after reloading the kernel image."
                               Foreground="#FF808080" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblTapAdapter" Text="TAP Adapter:" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="TapAdapterBox" Grid.Column="1" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblGatewayIP" Text="Gateway IP:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="NatGatewayIpBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblGatewayMAC" Text="Gateway MAC:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="NatGatewayMacBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                    </Grid>

                    <!-- Framebuffer -->
                    <TextBlock x:Name="LblFramebuffer" Text="Framebuffer" Style="{StaticResource SectionHeaderStyle}" />
                    <CheckBox x:Name="FramebufferEnabledBox" Content="Enable Framebuffer"
                              Foreground="#FFD4D4D4" Margin="0,4" />
                    <TextBlock x:Name="LblFramebufferDescription" Text="Provides a virtual framebuffer for X Window System. VRAM is placed at the top of RAM automatically. Changes take effect after rebooting the guest OS."
                               Foreground="#FF808080" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,4" />
                    <Grid Margin="24,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblFbResolution" Text="Resolution:" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="FbResolutionBox" Grid.Column="1" Width="160" HorizontalAlignment="Left">
                            <ComboBoxItem Content="320 x 240" />
                            <ComboBoxItem Content="640 x 480" />
                            <ComboBoxItem Content="800 x 600" />
                            <ComboBoxItem Content="1024 x 768" />
                            <ComboBoxItem Content="1280 x 720" />
                            <ComboBoxItem Content="1280 x 1024" />
                            <ComboBoxItem Content="1920 x 1080" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="24,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblFbBpp" Text="Bits per Pixel:" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="FbBppBox" Grid.Column="1" Width="110" HorizontalAlignment="Left">
                            <ComboBoxItem Content="8" />
                            <ComboBoxItem Content="16" />
                            <ComboBoxItem Content="32" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>

        <!-- ==================== Advanced Tab ==================== -->
        <TabViewItem x:Name="TabAdvanced" Header="Advanced" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="420" MaxHeight="420" Background="Transparent">
                <StackPanel Spacing="0" Background="Transparent">
                    <!-- Performance -->
                    <TextBlock x:Name="LblPerformance" Text="Performance" Style="{StaticResource SectionHeaderStyle}" />
                    <CheckBox x:Name="JitEnabledBox" Content="Enable JIT Compiler (experimental)"
                              Foreground="#FFD4D4D4" Margin="0,4" />
                    <TextBlock x:Name="LblJitDescription" Text="Compiles register-only basic blocks for faster execution. May slightly reduce performance on some workloads."
                               Foreground="#FF808080" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,4" />
                    <Grid Margin="24,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" /><ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblMinBlockLength" Text="Min Block Length:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="JitMinBlockLengthBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                    </Grid>
                    <Grid Margin="24,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" /><ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblCompileThreshold" Text="Compile Threshold:" Style="{StaticResource SettingLabelStyle}" />
                        <TextBox x:Name="JitCompileThresholdBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                    </Grid>

                    <!-- Debug -->
                    <TextBlock x:Name="LblDebug" Text="Debug" Style="{StaticResource SectionHeaderStyle}" />
                    <CheckBox x:Name="EnableTraceButtonBox" Content="Show Trace Button"
                              Foreground="#FFD4D4D4" Margin="0,4" />
                    <TextBlock x:Name="LblTraceDescription" Text="When enabled, a Trace button appears on the toolbar. Clicking it toggles verbose instruction tracing to a log file."
                               Foreground="#FF808080" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,4" />
                    <TextBlock x:Name="LblTraceFilePath" Text="" Foreground="#FF808080" FontSize="11" Margin="24,0,0,4" IsTextSelectionEnabled="True" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
    </TabView>
</ContentDialog>
