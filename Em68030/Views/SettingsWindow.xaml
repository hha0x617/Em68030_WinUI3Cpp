<ContentDialog
    x:Class="Em68030.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Emulator Settings"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    MinWidth="640"
    MinHeight="500"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD4D4D4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFD4D4D4" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF569CD6" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E42" />
            <Setter Property="Foreground" Value="#FFD4D4D4" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500" Background="Transparent">
        <StackPanel Spacing="0" Background="Transparent">
            <!-- Board Type -->
            <TextBlock Text="Board Type" Style="{StaticResource SectionHeaderStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Board:" Style="{StaticResource SettingLabelStyle}" />
                <ComboBox x:Name="BoardTypeBox" Grid.Column="1">
                    <ComboBoxItem Content="Generic" />
                    <ComboBoxItem Content="MVME147" />
                </ComboBox>
            </Grid>

            <!-- MVME147 Settings -->
            <StackPanel x:Name="Mvme147Panel" Visibility="Collapsed">
                <TextBlock Text="MVME147 Settings" Style="{StaticResource SectionHeaderStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ROM Image:" Style="{StaticResource SettingLabelStyle}" />
                    <TextBox x:Name="Mvme147RomBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                    <Button x:Name="BrowseRomBtn" Content="..." Grid.Column="2"
                            Style="{StaticResource BrowseButtonStyle}" />
                </Grid>

                <!-- Target OS -->
                <TextBlock Text="Target OS" Style="{StaticResource SectionHeaderStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Operating System:" Style="{StaticResource SettingLabelStyle}" />
                    <ComboBox x:Name="TargetOSBox" Grid.Column="1">
                        <ComboBoxItem Content="NetBSD" />
                        <ComboBoxItem Content="Linux" />
                    </ComboBox>
                </Grid>
                <!-- NetBSD-specific settings -->
                <StackPanel x:Name="NetBsdPanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Boot Partition:" Style="{StaticResource SettingLabelStyle}" />
                        <ComboBox x:Name="BootPartitionBox" Grid.Column="1"
                                  Width="60" HorizontalAlignment="Left">
                            <ComboBoxItem Content="a" />
                            <ComboBoxItem Content="b" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
                <!-- Linux-specific settings -->
                <StackPanel x:Name="LinuxPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Command Line:" Style="{StaticResource SettingLabelStyle}" />
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto"
                                      Background="Transparent" Padding="0">
                            <TextBox x:Name="LinuxCommandLineBox" Style="{StaticResource SettingTextBoxStyle}"
                                     MinWidth="400" />
                        </ScrollViewer>
                    </Grid>
                </StackPanel>

                <!-- SCSI Disk Settings -->
                <TextBlock Text="SCSI Disks" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel x:Name="ScsiDiskListPanel" />
                <Button x:Name="AddScsiDiskBtn" Content="+ Add Disk"
                        Margin="0,4" Padding="8,2"
                        Background="#FF3E3E42" Foreground="#FFD4D4D4" />
                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <TextBlock Text="New Image Size (MB):" Style="{StaticResource SettingLabelStyle}" Width="150" />
                    <TextBox x:Name="NewScsiImageSizeBox" Width="60" Style="{StaticResource SettingTextBoxStyle}" Text="100" />
                    <Button x:Name="CreateScsiImageBtn" Content="Create" Margin="8,0"
                            Background="#FF3E3E42" Foreground="#FFD4D4D4" Padding="8,2" />
                </StackPanel>

                <!-- SCSI CD-ROM Settings -->
                <TextBlock Text="SCSI CD-ROM" Style="{StaticResource SectionHeaderStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ISO Image:" Style="{StaticResource SettingLabelStyle}" />
                    <TextBox x:Name="ScsiCdromPathBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                    <Button x:Name="BrowseScsiCdromBtn" Content="..." Grid.Column="2"
                            Style="{StaticResource BrowseButtonStyle}" />
                    <TextBlock Text="SCSI ID:" Grid.Row="1" Style="{StaticResource SettingLabelStyle}" />
                    <ComboBox x:Name="ScsiCdromIdBox" Grid.Row="1" Grid.Column="1"
                              Width="60" HorizontalAlignment="Left">
                        <ComboBoxItem Content="0" />
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                        <ComboBoxItem Content="5" />
                        <ComboBoxItem Content="6" />
                    </ComboBox>
                </Grid>
                <!-- Network Mode -->
                <TextBlock Text="Network" Style="{StaticResource SectionHeaderStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Network Mode:" Style="{StaticResource SettingLabelStyle}" />
                    <ComboBox x:Name="NetworkModeBox" Grid.Column="1">
                        <ComboBoxItem Content="Virtual (Echo Server)" />
                        <ComboBoxItem Content="NAT (Host Network)" />
                    </ComboBox>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gateway IP:" Style="{StaticResource SettingLabelStyle}" />
                    <TextBox x:Name="NatGatewayIpBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gateway MAC:" Style="{StaticResource SettingLabelStyle}" />
                    <TextBox x:Name="NatGatewayMacBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                </Grid>
            </StackPanel>

            <!-- Memory Settings -->
            <TextBlock Text="Memory" Style="{StaticResource SectionHeaderStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Memory Size (MB):" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="MemSizeBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
            </Grid>

            <!-- I/O Device Settings -->
            <TextBlock Text="I/O Devices" Style="{StaticResource SectionHeaderStyle}" />
            <CheckBox x:Name="ConsoleEnabledBox" Content="Console Device Enabled"
                      Foreground="#FFD4D4D4" Margin="0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Console Base Addr:" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="ConsoleAddrBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scrollback Lines:" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="ConsoleScrollbackBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Terminal Size:" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="ConsoleColumnsBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                <TextBlock Text=" x " Grid.Column="2" Style="{StaticResource SettingLabelStyle}" HorizontalAlignment="Center" />
                <TextBox x:Name="ConsoleRowsBox" Grid.Column="3" Style="{StaticResource SettingTextBoxStyle}" />
            </Grid>

            <CheckBox x:Name="HddEnabledBox" Content="HDD Device Enabled"
                      Foreground="#FFD4D4D4" Margin="0,8,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HDD Base Addr:" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="HddAddrBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
            </Grid>

            <!-- HDD Image Settings -->
            <TextBlock Text="HDD Image" Style="{StaticResource SectionHeaderStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Image File:" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="HddPathBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                <Button x:Name="BrowseHddBtn" Content="..." Grid.Column="2"
                        Style="{StaticResource BrowseButtonStyle}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8">
                <TextBlock Text="New Image Size (MB):" Style="{StaticResource SettingLabelStyle}" Width="150" />
                <TextBox x:Name="NewImageSizeBox" Width="60" Style="{StaticResource SettingTextBoxStyle}" Text="32" />
                <Button x:Name="CreateHddImageBtn" Content="Create" Margin="8,0"
                        Background="#FF3E3E42" Foreground="#FFD4D4D4" Padding="8,2" />
            </StackPanel>

            <!-- Performance -->
            <TextBlock Text="Performance" Style="{StaticResource SectionHeaderStyle}" />
            <CheckBox x:Name="JitEnabledBox" Content="Enable JIT Compiler (experimental)"
                      Foreground="#FFD4D4D4" Margin="0,4" />
            <TextBlock Text="Compiles register-only basic blocks for faster execution. May slightly reduce performance on some workloads."
                       Foreground="#FF808080" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,4" />
            <Grid Margin="24,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" /><ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Min Block Length:" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="JitMinBlockLengthBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
            </Grid>
            <Grid Margin="24,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" /><ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Compile Threshold:" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="JitCompileThresholdBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
            </Grid>

            <!-- Display Settings -->
            <TextBlock Text="Display" Style="{StaticResource SectionHeaderStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Font Family:" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="FontFamilyBox" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
                <TextBlock Text="Font Size:" Grid.Row="1" Style="{StaticResource SettingLabelStyle}" />
                <TextBox x:Name="FontSizeBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingTextBoxStyle}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
