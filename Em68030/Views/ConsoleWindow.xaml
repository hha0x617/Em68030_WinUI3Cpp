<Window
    x:Class="Em68030.ConsoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Console">

    <Grid Background="{ThemeResource ThemeConsoleBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Terminal output area -->
        <TextBox x:Name="OutputBox" Grid.Row="0"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 FontFamily="Consolas" FontSize="14"
                 Background="{ThemeResource ThemeConsoleBg}" Foreground="{ThemeResource ThemeConsoleFg}"
                 BorderThickness="0"
                 Padding="4"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TextBox.Resources>
                <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="ThemeConsoleFg" />
                <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="ThemeConsoleFg" />
                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ThemeConsoleBg" />
                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ThemeConsoleBg" />
            </TextBox.Resources>
        </TextBox>

        <!-- Search bar (hidden by default, shown at bottom) -->
        <Grid x:Name="SearchBar" Grid.Row="1" Background="{ThemeResource ThemePanelBg}"
              Padding="4" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0"
                     FontFamily="Consolas" FontSize="13"
                     Background="{ThemeResource ThemeWindowBg}" Foreground="{ThemeResource ThemeForeground}"
                     BorderBrush="{ThemeResource ThemeBorder}" Padding="4,2"
                     PlaceholderText="Search..." />
            <TextBlock x:Name="SearchStatus" Grid.Column="1"
                       Foreground="{ThemeResource ThemeDimFg}" FontSize="12"
                       VerticalAlignment="Center" Margin="8,0" />
            <ToggleButton x:Name="CaseSensitiveToggle" Grid.Column="2" Content="Aa"
                    FontFamily="Consolas" FontSize="12"
                    Background="Transparent" BorderThickness="0"
                    Padding="6,4" Margin="2,0"
                    ToolTipService.ToolTip="Match Case" />
            <ToggleButton x:Name="RegexToggle" Grid.Column="3" Content=".*"
                    FontFamily="Consolas" FontSize="12"
                    Background="Transparent" BorderThickness="0"
                    Padding="6,4" Margin="2,0"
                    ToolTipService.ToolTip="Regular Expression" />
            <Button x:Name="SearchPrevBtn" Grid.Column="4" Content="&#xE010;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                    Background="Transparent" BorderThickness="0"
                    Padding="6,4" Margin="2,0"
                    ToolTipService.ToolTip="Previous (Shift+F3)" />
            <Button x:Name="SearchNextBtn" Grid.Column="5" Content="&#xE011;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                    Background="Transparent" BorderThickness="0"
                    Padding="6,4" Margin="2,0"
                    ToolTipService.ToolTip="Next (F3)" />
            <Button x:Name="SearchCloseBtn" Grid.Column="6" Content="&#xE10A;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12"
                    Background="Transparent" BorderThickness="0"
                    Padding="6,4" Margin="2,0"
                    ToolTipService.ToolTip="Close (Esc)" />
        </Grid>
    </Grid>
</Window>
