<Window
    x:Class="Em68030.BreakpointsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Breakpoints">

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Breakpoint list -->
        <ListView x:Name="BreakpointList" Grid.Row="0"
                  Background="#FF1E1E1E" BorderThickness="0"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Bottom toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#FF2D2D30" Padding="4,4">
            <Button x:Name="ClearAllButton" Content="Clear All"
                    Background="#FF3E3E42" Foreground="#FFD4D4D4"
                    BorderBrush="#FF555555" Padding="8,3" Margin="4"
                    FontFamily="Segoe UI" FontSize="12" />
        </StackPanel>
    </Grid>
</Window>
