<Window
    x:Class="Em68030.BreakpointsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Breakpoints">

    <Grid Background="{ThemeResource ThemeWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Breakpoint and watchpoint list -->
        <ListView x:Name="BreakpointList" Grid.Row="0"
                  Background="{ThemeResource ThemeWindowBg}" BorderThickness="0"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Bottom toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="{ThemeResource ThemePanelBg}" Padding="4,4">
            <Button x:Name="AddWatchpointButton" Content="Add Watchpoint"
                    Background="{ThemeResource ThemeControlBg}" Foreground="{ThemeResource ThemeForeground}"
                    BorderBrush="{ThemeResource ThemeButtonBorder}" Padding="8,3" Margin="4"
                    FontFamily="Segoe UI" FontSize="12" />
            <Button x:Name="ClearAllButton" Content="Clear All"
                    Background="{ThemeResource ThemeControlBg}" Foreground="{ThemeResource ThemeForeground}"
                    BorderBrush="{ThemeResource ThemeButtonBorder}" Padding="8,3" Margin="4"
                    FontFamily="Segoe UI" FontSize="12" />
        </StackPanel>
    </Grid>
</Window>
