<Window
    x:Class="Em68030.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Em68030"
    Title="Em68030 - MC68030 Emulator (C++/WinUI3)">

    <Grid Background="#FF1E1E1E" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="MonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#FFD4D4D4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RegisterTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="#FF2D2D30" />
                <Setter Property="Foreground" Value="#FFD4D4D4" />
                <Setter Property="BorderBrush" Value="#FF3F3F46" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,3,6,4" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement"
                                                    Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{ThemeResource TextControlBorderBrushPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement"
                                                    Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement"
                                                    Storyboard.TargetProperty="Opacity">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="0.5" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <!-- Empty ButtonStates group: TextBox expects these states
                                         but we omit the DeleteButton element entirely -->
                                    <VisualStateGroup x:Name="ButtonStates">
                                        <VisualState x:Name="ButtonVisible" />
                                        <VisualState x:Name="ButtonCollapsed" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="BorderElement"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <ScrollViewer x:Name="ContentElement"
                                        HorizontalScrollMode="Auto"
                                        VerticalScrollMode="Disabled"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Disabled"
                                        Margin="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        IsTabStop="False"
                                        ZoomMode="Disabled" />
                                <TextBlock x:Name="PlaceholderTextContentPresenter"
                                        Foreground="{ThemeResource TextControlPlaceholderForeground}"
                                        Text="{TemplateBinding PlaceholderText}"
                                        Margin="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ToolBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF3E3E42" />
                <Setter Property="Foreground" Value="#FFD4D4D4" />
                <Setter Property="BorderBrush" Value="#FF555555" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="ToolBarToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#FF3E3E42" />
                <Setter Property="Foreground" Value="#FFD4D4D4" />
                <Setter Property="BorderBrush" Value="#FF555555" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="SmallToolBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF3E3E42" />
                <Setter Property="Foreground" Value="#FFD4D4D4" />
                <Setter Property="BorderBrush" Value="#FF555555" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <!-- Row 0: MenuBar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Main content -->
            <RowDefinition Height="*" />
            <!-- Row 3: Status bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <MenuBar Grid.Row="0" Background="#FF2D2D30">
            <MenuBarItem Title="File">
                <MenuFlyoutItem x:Name="MenuOpenBinary" Text="Open Binary...">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuOpenSRecord" Text="Open S-Record..." />
                <MenuFlyoutItem x:Name="MenuOpenElf" Text="Open ELF..." />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuExit" Text="Exit">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F4" Modifiers="Menu" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Run">
                <MenuFlyoutItem x:Name="MenuRun" Text="Run (F5)" />
                <MenuFlyoutItem x:Name="MenuStop" Text="Stop (Shift+F5)" />
                <MenuFlyoutItem x:Name="MenuStep" Text="Step (F10)" />
                <MenuFlyoutItem x:Name="MenuRunToCursor" Text="Run to Cursor (F4)" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuSetPCToCursor" Text="Set PC to Cursor" />
                <MenuFlyoutItem x:Name="MenuReset" Text="Reset" />
                <MenuFlyoutItem x:Name="MenuFullReset" Text="Full Reset" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem x:Name="MenuShowConsole" Text="Console Window" />
                <MenuFlyoutItem x:Name="MenuShowBreakpoints" Text="Breakpoints Window" />
                <MenuFlyoutItem x:Name="MenuToggleLst" Text="Toggle LST View" />
            </MenuBarItem>
            <MenuBarItem Title="Settings">
                <MenuFlyoutItem x:Name="MenuSettings" Text="Emulator Settings..." />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem x:Name="MenuAbout" Text="About..." />
            </MenuBarItem>
        </MenuBar>

        <!-- Toolbar (replaces WPF ToolBarTray/ToolBar) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#FF2D2D30"
                    Padding="4,2" Spacing="2">
            <Button x:Name="BtnRun" Content="Run (F5)" Style="{StaticResource ToolBarButtonStyle}" />
            <Button x:Name="BtnStop" Content="Stop" Style="{StaticResource ToolBarButtonStyle}" />
            <Button x:Name="BtnStep" Content="Step (F10)" Style="{StaticResource ToolBarButtonStyle}" />
            <Button x:Name="BtnReset" Content="Reset" Style="{StaticResource ToolBarButtonStyle}" />
            <Button x:Name="BtnFullReset" Content="Full Reset" Style="{StaticResource ToolBarButtonStyle}" />
            <Button x:Name="BtnTrace" Content="Trace" Style="{StaticResource ToolBarButtonStyle}" />
            <Border Width="1" Background="#FF555555" Margin="4,2" />
            <TextBlock x:Name="FileNameText" Text="File: (none)" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="13" Foreground="#FFD4D4D4" Margin="8,0" />
            <TextBlock x:Name="CycleCountText" Text="Cycles: 0" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="13" Foreground="#FFD4D4D4" Margin="8,0" />
            <TextBlock x:Name="MhzText" Text="" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="13" Foreground="LightGreen" Margin="8,0" />
            <TextBlock x:Name="StopReasonText" Text="" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="13" Foreground="Orange" Margin="8,0" />
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="0">
            <Grid.RowDefinitions>
                <!-- Upper pane: Disassembly -->
                <RowDefinition Height="3*" />
                <!-- Lower pane: Memory Dump -->
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Disassembly View -->
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#FF3F3F46" BorderThickness="1" Margin="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Disassembly toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FF2D2D30" Padding="4,2">
                            <TextBlock Text="Disassembly" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#FF569CD6" Margin="4,2"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Address:" FontFamily="Consolas" FontSize="13"
                                       Foreground="#FFD4D4D4" VerticalAlignment="Center" Margin="16,0,4,0" />
                            <TextBox x:Name="DisasmAddrBox" Width="80" FontFamily="Consolas" FontSize="13"
                                     Background="#FF2D2D30" Foreground="#FFD4D4D4"
                                     BorderBrush="#FF3F3F46" VerticalAlignment="Center" />
                            <TextBlock Text="Size:" FontFamily="Consolas" FontSize="13"
                                       Foreground="#FFD4D4D4" VerticalAlignment="Center" Margin="8,0,2,0" />
                            <TextBox x:Name="DisasmSizeBox" Width="50" FontFamily="Consolas" FontSize="13"
                                     Background="#FF2D2D30" Foreground="#FFD4D4D4"
                                     BorderBrush="#FF3F3F46" VerticalAlignment="Center" Text="1024" />
                            <Button x:Name="BtnDisasmGo" Content="Go" Style="{StaticResource ToolBarButtonStyle}" Margin="4,2" />
                            <ToggleButton x:Name="BtnFollowPC" Content="Follow PC" IsChecked="True"
                                         Style="{StaticResource ToolBarToggleButtonStyle}" Margin="4,2" />
                            <Button x:Name="LstButton" Content="LST"
                                    Style="{StaticResource ToolBarButtonStyle}" Margin="8,2"
                                    Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Disassembly list (items populated programmatically) -->
                        <ListView x:Name="DisasmList" Grid.Row="1"
                                  Background="#FF1E1E1E" BorderThickness="0"
                                  SelectionMode="Extended">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="CtxCopy" Text="Copy">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="C" Modifiers="Control" />
                                        </MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="CtxRunToCursor" Text="Run to Cursor" />
                                    <MenuFlyoutItem x:Name="CtxSetPC" Text="Set PC to Address" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Cancel" />
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Border>

            <!-- Register Panel (spans all rows) -->
            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="#FF3F3F46" BorderThickness="1" Margin="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                        <StackPanel Margin="4" Background="Transparent">
                            <!-- Register header with edit buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Registers" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#FF569CD6" Margin="4,2" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnEditReg" Content="Edit"
                                            Style="{StaticResource SmallToolBarButtonStyle}" Margin="2,0" />
                                    <Button x:Name="BtnApplyReg" Content="Apply"
                                            Style="{StaticResource SmallToolBarButtonStyle}" Margin="2,0" />
                                    <Button x:Name="BtnCancelReg" Content="Cancel"
                                            Style="{StaticResource SmallToolBarButtonStyle}" Margin="2,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Data Registers -->
                            <TextBlock Text="Data Registers" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#FF4EC9B0" Margin="4,8,4,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="D0:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegD0" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="D1:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegD1" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="D2:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegD2" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="D3:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegD3" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="D4:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegD4" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="D5:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegD5" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="D6:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegD6" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="D7:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegD7" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Address Registers -->
                            <TextBlock Text="Address Registers" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#FF4EC9B0" Margin="4,8,4,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="A0:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegA0" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="A1:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegA1" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="A2:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegA2" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="A3:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegA3" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="A4:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegA4" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="A5:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegA5" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="A6:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegA6" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="A7:" Width="30" Style="{StaticResource MonoTextStyle}" />
                                    <TextBox x:Name="RegA7" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Flags -->
                            <TextBlock Text="Flags" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#FF4EC9B0" Margin="4,8,4,2" />
                            <StackPanel Orientation="Horizontal" Margin="2" Spacing="4">
                                <CheckBox x:Name="FlagX" Content="X" Foreground="#FFD4D4D4" MinWidth="0" />
                                <CheckBox x:Name="FlagN" Content="N" Foreground="#FFD4D4D4" MinWidth="0" />
                                <CheckBox x:Name="FlagZ" Content="Z" Foreground="#FFD4D4D4" MinWidth="0" />
                                <CheckBox x:Name="FlagV" Content="V" Foreground="#FFD4D4D4" MinWidth="0" />
                                <CheckBox x:Name="FlagC" Content="C" Foreground="#FFD4D4D4" MinWidth="0" />
                                <CheckBox x:Name="FlagS" Content="S" Foreground="#FFD4D4D4" MinWidth="0" />
                                <CheckBox x:Name="FlagT" Content="T" Foreground="#FFD4D4D4" MinWidth="0" />
                            </StackPanel>

                            <!-- Special Registers -->
                            <TextBlock Text="Special Registers" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#FF4EC9B0" Margin="4,8,4,2" />
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="PC: " Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegPC" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="SR: " Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegSR" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="SSP:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegSSP" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="VBR:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegVBR" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                            </StackPanel>

                            <!-- FPU Registers -->
                            <TextBlock Text="FPU Registers" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#FF4EC9B0" Margin="4,8,4,2" />
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="FP0:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFP0" Width="130" Style="{StaticResource RegisterTextBoxStyle}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="FP1:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFP1" Width="130" Style="{StaticResource RegisterTextBoxStyle}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="FP2:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFP2" Width="130" Style="{StaticResource RegisterTextBoxStyle}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="FP3:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFP3" Width="130" Style="{StaticResource RegisterTextBoxStyle}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="FP4:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFP4" Width="130" Style="{StaticResource RegisterTextBoxStyle}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="FP5:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFP5" Width="130" Style="{StaticResource RegisterTextBoxStyle}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="FP6:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFP6" Width="130" Style="{StaticResource RegisterTextBoxStyle}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="FP7:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFP7" Width="130" Style="{StaticResource RegisterTextBoxStyle}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="CR: " Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFPCR" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="SR: " Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFPSR" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="IAR:" Width="35" Style="{StaticResource MonoTextStyle}" />
                                <TextBox x:Name="RegFPIAR" Width="95" Style="{StaticResource RegisterTextBoxStyle}" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
            </Border>

            <!-- Lower pane: Memory Dump -->
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#FF3F3F46" BorderThickness="1" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Memory toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FF2D2D30" Padding="4,2">
                        <TextBlock Text="Memory Dump" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#FF569CD6" Margin="4,2"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Address:" FontFamily="Consolas" FontSize="13"
                                   Foreground="#FFD4D4D4" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <TextBox x:Name="MemAddrBox" Width="80" FontFamily="Consolas" FontSize="13"
                                 Background="#FF2D2D30" Foreground="#FFD4D4D4"
                                 BorderBrush="#FF3F3F46" VerticalAlignment="Center" />
                        <TextBlock Text="Size:" FontFamily="Consolas" FontSize="13"
                                   Foreground="#FFD4D4D4" VerticalAlignment="Center" Margin="8,0,2,0" />
                        <TextBox x:Name="MemSizeBox" Width="50" FontFamily="Consolas" FontSize="13"
                                 Background="#FF2D2D30" Foreground="#FFD4D4D4"
                                 BorderBrush="#FF3F3F46" VerticalAlignment="Center" Text="256" />
                        <Button x:Name="BtnMemGo" Content="Go" Style="{StaticResource ToolBarButtonStyle}" Margin="4,2" />
                        <Border Width="1" Background="#FF555555" Margin="8,2" />
                        <Button x:Name="BtnMemEdit" Content="Edit" Style="{StaticResource ToolBarButtonStyle}" Margin="4,2" />
                        <Button x:Name="BtnMemApply" Content="Apply" Style="{StaticResource ToolBarButtonStyle}" Margin="4,2" />
                        <Button x:Name="BtnMemCancel" Content="Cancel" Style="{StaticResource ToolBarButtonStyle}" Margin="4,2" />
                    </StackPanel>

                    <!-- Memory dump content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto" Background="#FF1E1E1E">
                        <Grid>
                            <TextBox x:Name="MemoryDumpText"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="13"
                                     Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                                     BorderThickness="0" />
                            <StackPanel x:Name="MemoryEditPanel" Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#FF007ACC" Padding="8,4">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Running: False" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="NetworkModeText" Text="" Foreground="White" FontSize="12" Margin="16,0,0,0" />
                    <TextBlock x:Name="JitStatusText" Text="" Foreground="White" FontSize="12" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="TraceStatusText" Text="" Foreground="Yellow"
                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>

</Window>
