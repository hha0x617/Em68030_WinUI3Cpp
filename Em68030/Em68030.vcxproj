  <!-- Generate GitVersion.h with the current git commit hash -->
  <Target Name="GenerateGitVersion" BeforeTargets="ClCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <GitCommitHash Condition="'$(GitCommitHash)' == ''">unknown</GitCommitHash>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntDir)GitVersion.h"
                     Lines="#pragma once%0D%0A#define GIT_COMMIT_HASH &quot;$(GitCommitHash)&quot;"
                     Overwrite="true" />
  </Target>
