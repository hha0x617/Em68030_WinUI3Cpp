  <!-- Fix MSB8027: WindowsAppSDK NuGet's foundation package adds
       WindowsAppRuntimeAutoInitializer.cpp via both build\native and
       buildTransitive\native .targets, causing a duplicate ClCompile entry.
       1. Suppress the MSB8027 warning (cosmetic: NuGet packaging issue).
       2. Deduplicate ClCompile items before compilation to prevent LNK4042. -->
  <PropertyGroup>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB8027</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <Target Name="DeduplicateClCompile" BeforeTargets="ClCompile">
    <RemoveDuplicates Inputs="@(ClCompile)">
      <Output TaskParameter="Filtered" ItemName="_DeduplicatedClCompile" />
    </RemoveDuplicates>
    <ItemGroup>
      <ClCompile Remove="@(ClCompile)" />
      <ClCompile Include="@(_DeduplicatedClCompile)" />
    </ItemGroup>
  </Target>
  <!--
    Fix: WinUI 3 XAML compiler integration for C++ native projects.
    The WinUI 3 NuGet only wires Pass2 into PrepareResourcesDependsOn (managed-only).
    For C++ projects we must manually:
    1. Wire Pass1 + Pass2 into BeforeClCompileTargets (after MIDL/CppWinRT)
    2. Set XamlLocalAssembly to the CppWinRT-merged .winmd
    3. Populate @(WinMDReferenceToCompile) with WinUI + SDK winmds for Pass2
    4. Add XamlTypeInfo.Impl.g.cpp to compilation (Pass1 generates it but
       only adds it to @(XamlGFiles), not @(ClCompile), for native projects)
  -->
  <PropertyGroup>
    <MarkupCompilePass1DependsOn>ResolveAssemblyReferences;AddXamlCompilerReferences;$(MarkupCompilePass1DependsOn)</MarkupCompilePass1DependsOn>
    <MarkupCompilePass2DependsOn>ResolveAssemblyReferences;AddXamlCompilerReferences;$(MarkupCompilePass2DependsOn)</MarkupCompilePass2DependsOn>
    <!-- Wire both XAML passes into the C++ build chain, after MIDL/CppWinRT
         but before ClCompile so generated code is compiled in the same pass -->
    <BeforeClCompileTargets>
      MarkupCompilePass1;
      MarkupCompilePass2;
      $(BeforeClCompileTargets)
    </BeforeClCompileTargets>
    <!-- Point XAML compiler Pass2 at the CppWinRT-merged project .winmd -->
    <XamlLocalAssembly>$(IntDir)Merged\$(TargetName).winmd</XamlLocalAssembly>
  </PropertyGroup>
  <!-- Provide all WinRT references needed by the XAML compiler.
       For Pass1: adds SDK winmds to @(ReferencePath).
       For Pass2: adds WinUI + SDK winmds DIRECTLY to @(XamlReferencesToCompile)
       because @(WinMDReferenceToCompile) isn't populated in BeforeClCompile context. -->
  <Target Name="AddXamlCompilerReferences">
    <ItemGroup>
      <!-- Windows SDK platform contract winmds (needed by Pass1 via @(ReferencePath)) -->
      <_WinSDKPlatformWinMDs Include="$(WindowsSdkPath)References\$(TargetPlatformVersion)\**\*.winmd" />
      <ReferencePath Include="@(_WinSDKPlatformWinMDs)" />
      <!-- Add directly to XamlReferencesToCompile for Pass2 (bypasses WinMDReferenceToCompile) -->
      <XamlReferencesToCompile Include="$(_MuxWinmdDir)Microsoft.UI.Xaml.winmd" />
      <XamlReferencesToCompile Include="$(_MuxWinmdDir)Microsoft.UI.Text.winmd" />
      <XamlReferencesToCompile Include="@(_WinSDKPlatformWinMDs)" />
    </ItemGroup>
  </Target>
  <!-- XamlTypeInfo.Impl.g.cpp: generated by Pass1 but not auto-added to
       ClCompile for native projects. Must be compiled for XamlMetaDataProvider. -->
  <ItemGroup>
    <ClCompile Include="$(IntDir)XamlTypeInfo.Impl.g.cpp" />
    <ClCompile Include="$(IntDir)XamlTypeInfo.g.cpp" />
  </ItemGroup>
